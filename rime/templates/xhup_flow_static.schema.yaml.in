# Rime schema
# encoding: utf-8
---
schema:
  schema_id: xhup_flow_static
  name: 小鹤音形(静态)
  version: "{{VERSION}}"
  author:
    - XHUP Flow
  # librime 部署只编译默认 translator 命名空间的词典;FIXED_FIRST
  # 辅助词典必须经官方 schema/dependencies 机制声明,部署器才会
  # 为它生成 table.bin(与 xhup_flow 同;真机部署验收发现)。
  dependencies:
    - xhup_flow_fixed_first_shortcuts
  description: |
    XHUP Flow 的静态兼容方案:与 xhup_flow 完全相同的静态输入层
    (一级简码、规范单字、全部词语简码、固定词语),不含 Flow 引擎
    (无组句、无用户词学习、无用户词典)。适用于调试、性能基准、
    隐私敏感场景与静态/动态 A/B 对照。不重复任何静态词典:与
    xhup_flow 引用同一组词典文件,仅 translator 组成不同。

switches:
  - name: ascii_mode
    reset: 0
    states: [中文, 西文]
  - name: ascii_punct
    states: [。，, ．，]
  - name: full_shape
    states: [半角, 全角]

engine:
  processors:
    - ascii_composer
    - key_binder
    - speller
    - punctuator
    - selector
    - navigator
    - express_editor
  segmentors:
    - ascii_segmentor
    - abc_segmentor
    - punct_segmentor
    - fallback_segmentor
  translators:
    - punct_translator
    - table_translator
    - table_translator@fixed_first

speller:
  alphabet: zyxwvutsrqponmlkjihgfedcba

translator:
  dictionary: xhup_flow
  enable_completion: false
  enable_sentence: false
  enable_user_dict: false
  initial_quality: 1000000

fixed_first:
  dictionary: xhup_flow_fixed_first_shortcuts
  enable_completion: false
  enable_sentence: false
  enable_user_dict: false
  initial_quality: 0

# 中英文切换不依赖客户端共享数据里的 default.yaml(部分平台的共享
# 数据没有 ascii_composer 配置,Shift 切换会静默失效):在方案内显式
# 声明 switch_key,与 Weasel 官方默认行为一致。
ascii_composer:
  good_old_caps_lock: true
  switch_key:
    Shift_L: inline_ascii
    Shift_R: commit_text
    Caps_Lock: clear

punctuator:
  import_preset: default

key_binder:
  import_preset: default
