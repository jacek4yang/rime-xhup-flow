# Rime schema
# encoding: utf-8
---
schema:
  schema_id: xhup_flow
  name: 小鹤音形
  version: "{{VERSION}}"
  author:
    - XHUP Flow
  # librime 部署只编译默认 translator 命名空间的词典;FIXED_FIRST /
  # Flow / Learn 三个辅助词典必须经官方 schema/dependencies 机制
  # 声明,Weasel / rime_deployer 才会为它们生成 table.bin(真机
  # 部署验收发现:缺失时 FIXED_FIRST 简码、组句与本地学习全部静默失效)。
  dependencies:
    - xhup_flow_fixed_first_shortcuts
    - xhup_flow_flow
    - xhup_flow_learn
  description: |
    XHUP Flow 的跨平台小鹤音形方案,仅使用标准 librime 核心组件。
    当前版本提供 26 个一级简码字、规范单字(二至四码)、高稳健零冲突
    词语简码(别名,不替换完整码)、二码零冲突词语简码(仅完全空闲的
    二键码位)与高频固定词语(二至四字)输入;
    一级简码只提供一键精确候选,不会自动上屏;
    词语按逐字双拼两码拼接,二字词仅收录不与规范四码单字冲突者;
    高稳健 FIXED_FIRST 词语简码由独立的第二 translator 提供,严格排在
    既有固定候选之后,不改变任何已有候选的相对次序;
    Flow 引擎提供连续组句与本地用户词学习(独立第三 translator,
    initial_quality 0,严格排在全部静态候选之后;用户数据仅存本地)。

switches:
  - name: ascii_mode
    reset: 0
    states: [中文, 西文]
  - name: ascii_punct
    states: [。，, ．，]
  - name: full_shape
    states: [半角, 全角]

engine:
  processors:
    - ascii_composer
    - key_binder
    - speller
    - punctuator
    - selector
    - navigator
    - express_editor
  segmentors:
    - ascii_segmentor
    - abc_segmentor
    - punct_segmentor
    - fallback_segmentor
  translators:
    - punct_translator
    - table_translator
    - table_translator@fixed_first
    - table_translator@flow
    - table_translator@learn
  filters:
    - uniquifier

speller:
  alphabet: zyxwvutsrqponmlkjihgfedcba

# primary translator:全部既有固定层与零冲突简码层。initial_quality
# 1000000 仅作为 translator 间优先级栅栏(常数同时加到全部 primary
# 候选,其内部相对次序完全不变),保证 FIXED_FIRST/Flow 候选严格排在
# 既有固定候选之后;它不是候选词频,也不参与 primary 内部排序。
translator:
  dictionary: xhup_flow
  enable_completion: false
  enable_sentence: false
  enable_user_dict: false
  initial_quality: 1000000

# FIXED_FIRST translator:高稳健重码词语简码(与既有固定码重码的高频词
# 别名),独立静态词典,initial_quality 0 使其候选永远位于 primary 之后。
fixed_first:
  dictionary: xhup_flow_fixed_first_shortcuts
  enable_completion: false
  enable_sentence: false
  enable_user_dict: false
  initial_quality: 0

# Flow translator:连续组句 + 句子词条学习。专用组句词典
# xhup_flow_flow 仅含词条 canonical 全码(无单字、无简码别名):句子
# 只由词组成,分段质量高,不产生逐字退化句子。携带共享用户词典
# xhup_flow_user(句子候选属于用户词典语言,提交时 Memorize 学习
# 其词条元素);initial_quality 0 保证候选永远位于全部静态候选之后。
flow:
  dictionary: xhup_flow_flow
  user_dict: xhup_flow_user
  enable_completion: false
  enable_sentence: true
  sentence_over_completion: true
  enable_user_dict: true
  initial_quality: 0

# learn translator:学习短语编码(encoder)。学习词典 xhup_flow_learn
# 含单字 + 词条全码(单字是规则式短语编码原语);enable_sentence
# false(单字组句会产生退化句子,组句由 flow translator 负责)。
# 单字/词条 exact 查询与 primary 静态层完全重合,经 uniquifier 去重后
# 不可见。共享同一用户词典 xhup_flow_user:flow 层句子提交属于该语言,
# 本层 Memorize 触发多元素 EncodePhrase,把 ≥5 字短语按「逐字声码
# 首键」规则编码入库。
learn:
  dictionary: xhup_flow_learn
  user_dict: xhup_flow_user
  enable_completion: false
  enable_sentence: false
  enable_user_dict: true
  enable_encoder: true
  encode_commit_history: true
  max_phrase_length: 20
  max_homographs: 1
  initial_quality: 0

# 中英文切换不依赖客户端共享数据里的 default.yaml(部分平台的共享
# 数据没有 ascii_composer 配置,Shift 切换会静默失效):在方案内显式
# 声明 switch_key,与 Weasel 官方默认行为一致。
ascii_composer:
  good_old_caps_lock: true
  switch_key:
    Shift_L: inline_ascii
    Shift_R: commit_text
    Caps_Lock: clear

punctuator:
  import_preset: default

key_binder:
  import_preset: default
