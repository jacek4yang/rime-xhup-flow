# Rime schema
# encoding: utf-8
---
schema:
  schema_id: xhup_flow
  name: 小鹤音形
  version: "{{VERSION}}"
  author:
    - XHUP Flow
  # librime 部署只编译默认 translator 命名空间的词典;Flow / Learn
  # 两个辅助词典必须经官方 schema/dependencies 机制
  # 声明,Weasel / rime_deployer 才会为它们生成 table.bin。
  dependencies:
    - xhup_flow_flow
    - xhup_flow_learn
  description: |
    XHUP Flow 2.0 智能化双拼音形方案。本方案需要 librime-lua 运行时支持
    (候选注释、上下文解码与运行时策略编排);在不支持或未启用 Lua 的
    环境，请安装 librime-plugin-lua 或切换使用静态兼容方案 xhup_flow_static
    (保留 100% 肌肉记忆与零 Lua 运行);
    当前版本提供 26 个一级简码字、core + attested 输入字符(二至四码)、
    canonical v2 词语简码(别名,不替换完整码)、hot 固定词语与完整 pinned
    secondary 词汇层；逐字两键原语保证词表外文本可参与组句;
    一级简码只提供一键精确候选,不会自动上屏;
    词语按逐字双拼两码拼接，二字词与四码单字碰撞时合法共存;
    PRIMARY 与 FIXED_FIRST 同主词典候选按 canonical v2 merged rank
    映射为唯一整数权重,不依赖文件导入顺序;
    Flow 引擎提供开放连续组句与本地用户词学习(独立后续 translator,
    严格排在全部静态候选之后;用户数据仅存本地)。

switches:
  - name: ascii_mode
    reset: 0
    states: [中文, 西文]
  - name: ascii_punct
    states: [。，, ．，]
  - name: full_shape
    states: [半角, 全角]
  # 简码提示(Lua quick_hint filter):开 = 候选注释追加 ~<简码>。
  # librime-lua 缺失时该组件被跳过,开关无效果,输入行为不变。
  - name: quick_hint
    reset: 1
    states: [关闭提示, 简码提示]
  # 候选注释调试模式:开 = 在注释中输出明确可信的元数据标签([S], [USR])。
  - name: debug_candidate_annotations
    reset: 0
    states: [常规注释, 调试注释]

engine:
  processors:
    - ascii_composer
    - key_binder
    - speller
    - punctuator
    - selector
    - navigator
    - express_editor
  segmentors:
    - ascii_segmentor
    - abc_segmentor
    - punct_segmentor
    - fallback_segmentor
  translators:
    - punct_translator
    - table_translator
    - table_translator@flow
    - table_translator@learn
  filters:
    # 候选注释与简码提示(xhup_flow mandatory Lua 运行时合同组件):
    # 候选注释格式化并追加 ~<简码>,只追加不重排;缺失 librime-lua 时无法
    # 提供 2.0 智能体验(需安装插件或选用 xhup_flow_static 方案)。
    # 顺序约束:注解类 filter 必须在 uniquifier 之前(与 rime-ice 等
    # 成熟方案一致)。实测(Ubuntu noble librime-lua git20230917):
    # lua_filter 位于 uniquifier 之后时,其协程 translation 会把每个
    # 菜单的末位候选额外回吐一次(uniquifier 按 text 去重,位于最后
    # 可兜底消化该重复);次序颠倒不影响提示语义(每候选至多注解一次,
    # 由本仓库 Lua 单测与 runtime 审计共同断言)。
    - lua_filter@*xhup_flow.quick_hint
    - uniquifier

speller:
  alphabet: zyxwvutsrqponmlkjihgfedcba

# primary translator:全部 canonical 静态层(PRIMARY + FIXED_FIRST +
# baseline)。同码次序由 merged_ranking 唯一整数权重表达;禁用 userdb,
# 静态顺序不受学习影响。initial_quality 只隔离后续 Flow/learn translator。
translator:
  dictionary: xhup_flow
  enable_completion: false
  enable_sentence: false
  enable_user_dict: false
  initial_quality: 1000000

# Flow translator:连续组句 + 句子词条学习。专用组句词典
# xhup_flow_flow 包含 hot/extended 词条与逐字两键音码原语:词汇证据
# 改善排名，单字确保词表外组合与语气字路径不中断。携带共享用户词典
# xhup_flow_user(句子候选属于用户词典语言,提交时 Memorize 学习
# 其词条元素);initial_quality 100 与 primary 的 1000000 质量栅栏保证
# 开放候选位于全部静态候选之后。
flow:
  dictionary: xhup_flow_flow
  user_dict: xhup_flow_user
  enable_completion: false
  enable_sentence: true
  sentence_over_completion: true
  enable_user_dict: true
  initial_quality: 100

# learn translator:学习短语编码(encoder)。学习词典 xhup_flow_learn
# 通过 import_tables 继承完整 Flow 关系并追加 3/4 键单字全码原语，
# 保证两个 translator 共享 xhup_flow_user 时 syllable-id 空间一致。
# enable_sentence false 避免单字组句产生退化句子；本层 Memorize 触发
# 多元素 EncodePhrase，把 ≥5 字短语按「逐字声码首键」规则编码入库。
learn:
  dictionary: xhup_flow_learn
  user_dict: xhup_flow_user
  enable_completion: false
  enable_sentence: false
  enable_user_dict: true
  enable_encoder: true
  encode_commit_history: true
  max_phrase_length: 20
  max_homographs: 1
  initial_quality: 1000

# 中英文切换不依赖客户端共享数据里的 default.yaml(部分平台的共享
# 数据没有 ascii_composer 配置,Shift 切换会静默失效):在方案内显式
# 声明 switch_key,与 Weasel 官方默认行为一致。
ascii_composer:
  good_old_caps_lock: true
  switch_key:
    Shift_L: inline_ascii
    Shift_R: commit_text
    Caps_Lock: clear

punctuator:
  import_preset: default

key_binder:
  import_preset: default
