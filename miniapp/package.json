{
  "name": "miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "XHUP Flow 微信小程序训练器(Taro + React)",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "none"
  },
  "scripts": {
    "generate:data": "node scripts/generate-shards.mjs",
    "build:weapp": "npm run generate:data && taro build --type weapp",
    "dev:weapp": "npm run generate:data && taro build --type weapp --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size-report.mjs"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "@xhup/trainer-core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@babel/preset-typescript": "^7.24.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@types/react": "^18.3.3",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "4.2.1",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11",
    "webpack": "5.91.0"
  }
}
