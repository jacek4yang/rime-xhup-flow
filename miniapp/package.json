{
  "name": "miniapp",
  "version": "2.1.0-rc.1",
  "private": true,
  "description": "XHUP Flow 微信小程序训练器(Taro + React)",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "none"
  },
  "scripts": {
    "generate:data": "pnpm --filter trainer generate:data && node scripts/build-dataset.mjs",
    "build:weapp": "npm run generate:data && taro build --type weapp && node scripts/test-weapp-runtime.cjs",
    "dev:weapp": "npm run generate:data && taro build --type weapp --watch",
    "typecheck": "pnpm generate:data && tsc --noEmit",
    "test": "pnpm generate:data && node --test scripts/build-dataset.test.mjs && vitest run --exclude src/lib/dataset.perf.test.ts && vitest run src/lib/dataset.perf.test.ts",
    "size": "node scripts/size-report.mjs"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "@xhup/trainer-core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/preset-env": "^7.24.4",
    "@babel/preset-react": "^7.24.1",
    "@babel/preset-typescript": "^7.24.1",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "18.3.7",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "4.2.1",
    "jsdom": "30.0.1",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11",
    "webpack": "5.111.1"
  }
}
