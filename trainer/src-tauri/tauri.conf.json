{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XHUP Flow",
  "version": "2.0.0-rc.2",
  "identifier": "io.github.jacek4yang.xhupflow",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "XHUP Flow · 小鹤音形训练",
        "width": 1152,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../rime/package/NOTICE.md": "licenses/rime-data/NOTICE.md",
      "../../LICENSE": "licenses/project/LICENSE",
      "../../LICENSE.GPL-3.0": "licenses/project/LICENSE.GPL-3.0",
      "../../data/words/LICENSE.wanxiang": "licenses/wanxiang/LICENSE.wanxiang",
      "../../data/hanzi/LICENSE.pinyin-data": "licenses/pinyin-data/LICENSE.pinyin-data",
      "../../data/corpus/LICENSE.kdconv": "licenses/kdconv/LICENSE.kdconv",
      "../../data/corpus/LICENSE.ptt": "licenses/ptt/LICENSE.ptt",
      "../../vendor/glib/LICENSE": "licenses/glib/LICENSE",
      "../../vendor/glib/COPYRIGHT": "licenses/glib/COPYRIGHT",
      "../../vendor/glib-macros/LICENSE": "licenses/glib-macros/LICENSE",
      "../../vendor/glib-macros/COPYRIGHT": "licenses/glib-macros/COPYRIGHT",
      "../../vendor/gtk3-macros/LICENSE": "licenses/gtk3-macros/LICENSE",
      "../../vendor/gtk3-macros/COPYRIGHT": "licenses/gtk3-macros/COPYRIGHT",
      "../../vendor/urlpattern/LICENSE": "licenses/urlpattern/LICENSE",
      "../../vendor/proc-macro-error2/LICENSE-MIT": "licenses/proc-macro-error2/LICENSE-MIT",
      "../../vendor/proc-macro-error2/LICENSE-APACHE": "licenses/proc-macro-error2/LICENSE-APACHE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
