diff --git a/lauxlib.c b/lauxlib.c
index 923105e..74f5935 100644
--- a/lauxlib.c
+++ b/lauxlib.c
@@ -1024,13 +1024,18 @@ LUALIB_API const char *luaL_gsub (lua_State *L, const char *s,
 
 
 static void *l_alloc (void *ud, void *ptr, size_t osize, size_t nsize) {
-  (void)ud; (void)osize;  /* not used */
+  size_t old_size = ptr ? osize : 0;  /* NULL uses osize as a type tag */
+  (void)ud;
   if (nsize == 0) {
     free(ptr);
+    xhup_profile_alloc(old_size, 0);
     return NULL;
   }
-  else
-    return realloc(ptr, nsize);
+  else {
+    void *result = realloc(ptr, nsize);
+    if (result) xhup_profile_alloc(old_size, nsize);
+    return result;
+  }
 }
 
 
